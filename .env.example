# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# sqlite (offline default) | neo4j
KGNOTES_GRAPH_STORE=sqlite
KGNOTES_DATA_DIR=data

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kgnotes-pass
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Extraction
# ---------------------------------------------------------------------------
# auto = LLM if configured, otherwise rules | heuristic | llm
KGNOTES_EXTRACTOR=auto
KGNOTES_MAX_CHUNK_CHARS=700
KGNOTES_CHUNK_OVERLAP=80
KGNOTES_MAX_TRIPLES_PER_CHUNK=20

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# auto = OpenAI-compatible embeddings when LLM_API_KEY is set, else hash
KGNOTES_EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384
KGNOTES_EMBEDDING_BATCH=32

# ---------------------------------------------------------------------------
# LLM (any OpenAI-compatible endpoint: OpenAI, DeepSeek, Qwen, Ollama, vLLM...)
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1200
KGNOTES_LLM_REWRITE=true

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
KGNOTES_TOP_K=6
KGNOTES_GRAPH_DEPTH=1
KGNOTES_GRAPH_NEIGHBORS=12
KGNOTES_MAX_CONTEXT_CHARS=7000

# ---------------------------------------------------------------------------
# HTTP API
# ---------------------------------------------------------------------------
KGNOTES_ALLOW_RESET=true
KGNOTES_CORS_ORIGINS=*
